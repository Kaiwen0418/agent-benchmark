AGENTBENCH_WEB_IMAGE=agentbench-web
AGENTBENCH_WEB_IMAGE_TAG=local
AGENTBENCH_WEB_PORT=3000
WEB_COMPOSE_PROJECT_NAME=agentbench-web

HOSTED_ORCHESTRATOR_URL=https://hosted.example.com/orchestrator
HOSTED_SITES_URL=https://hosted.example.com
RUNNER_SHARED_SECRET=replace-me

# Required while Web persistence is migrated incrementally from Supabase.
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Add the pooled PostgreSQL URL as Drizzle repositories are enabled.
DATABASE_URL=
DATABASE_POOL_MAX=3

GUEST_RUN_LIMIT=3
RUN_CONNECT_RATE_LIMIT=30

# Use different project names, credentials and ports for each environment.
ELK_PROJECT_NAME=agentbench-development-elk
DEPLOYMENT_ENVIRONMENT=development
ELASTIC_STACK_VERSION=8.19.23
ELK_GELF_PORT=12202
ELK_KIBANA_PORT=5602
ELK_GRAFANA_PORT=3302
ELK_RUNTIME_NETWORK=agentbench-local-development_default
PROMETHEUS_VERSION=v3.15.0
GRAFANA_VERSION=13.2.3
# Generate each secret independently: openssl rand -hex 32
ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
LOGSTASH_PASSWORD=
KIBANA_ENCRYPTION_KEY=
GRAFANA_ADMIN_PASSWORD=
HOSTED_METRICS_TOKEN=
